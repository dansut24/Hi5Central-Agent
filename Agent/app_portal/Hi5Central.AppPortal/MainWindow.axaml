                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="9" Margin="7,12,0,2">
          <TextBlock Text="Hi5 Self Service" Foreground="#7A899F" FontSize="9" />
          <TextBlock Text="Powered by Hi5Central" Foreground="#91A0B5" FontSize="8" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="68,*">
      <Border Grid.Row="0"
              Background="#FBFDFF"
              BorderBrush="#DFE7F1"
              BorderThickness="0,0,0,1"
              Padding="22,13">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
          <Border Grid.Column="0"
                  Width="500"
                  HorizontalAlignment="Left"
                  Background="White"
                  BorderBrush="#D5DFEC"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10,0">
            <Grid ColumnDefinitions="22,*" ColumnSpacing="6">
              <PathIcon Grid.Column="0"
                        Width="16"
                        Height="16"
                        Foreground="#66778E"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M16.1017 17.1624C14.717 18.3101 12.9391 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11C19 12.9391 18.3101 14.717 17.1624 16.1018L21.7803 20.7197C22.0732 21.0126 22.0732 21.4874 21.7803 21.7803C21.4874 22.0732 21.0125 22.0732 20.7196 21.7803L16.1017 17.1624ZM17.5 11C17.5 7.41015 14.5899 4.5 11 4.5C7.41015 4.5 4.5 7.41015 4.5 11C4.5 14.5899 7.41015 17.5 11 17.5C14.5899 17.5 17.5 14.5899 17.5 11Z" />
              <TextBox x:Name="SearchBox"
                       Grid.Column="1"
                       Watermark="Search for apps, tools, or help..."
                       TextChanged="SearchBox_TextChanged"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0,8"
                       FontSize="11" />
            </Grid>
          </Border>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="●" Foreground="#D83939" FontSize="10" VerticalAlignment="Top" />
            <PathIcon Width="22" Height="22" Foreground="#31445F" VerticalAlignment="Center"
                      Data="M6.25 4C5.00736 4 4 5.00736 4 6.25V13.75C4 14.9926 5.00736 16 6.25 16H17.75C18.9926 16 20 14.9926 20 13.75V6.25C20 5.00736 18.9926 4 17.75 4H6.25ZM5.5 6.25C5.5 5.83579 5.83579 5.5 6.25 5.5H17.75C18.1642 5.5 18.5 5.83579 18.5 6.25V13.75C18.5 14.1642 18.1642 14.5 17.75 14.5H6.25C5.83579 14.5 5.5 14.1642 5.5 13.75V6.25ZM2.75 17.5C2.33579 17.5 2 17.8358 2 18.25C2 18.6642 2.33579 19 2.75 19H21.25C21.6642 19 22 18.6642 22 18.25C22 17.8358 21.6642 17.5 21.25 17.5H2.75Z" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock x:Name="HeaderDeviceNameText"
                         Text="This device"
                         Foreground="#17233A"
                         FontSize="10"
                         FontWeight="Bold" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="●" Foreground="#22A06B" FontSize="8" />
                <TextBlock x:Name="HeaderDeviceStateText" Text="Online" Classes="muted" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="18" Background="#126DDC">
              <TextBlock x:Name="HeaderUserInitialsText"
                         Text="H5"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center" MinWidth="100">
              <TextBlock x:Name="HeaderUserText"
                         Text="Signed-in user"
                         Foreground="#17233A"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="Self Service" Classes="muted" />
            </StackPanel>
            <TextBlock Text="⌄" Foreground="#66768B" FontSize="14" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,18,22,26" Spacing="15">
            <StackPanel Spacing="2">
              <TextBlock x:Name="HeroEyebrow" IsVisible="False" />
              <TextBlock x:Name="HeroTitle"
                         Text="Hi5 Self Service"
                         Foreground="#111A2D"
                         FontSize="31"
                         FontWeight="Bold" />
              <TextBlock x:Name="HeroDescription"
                         Text="Your one stop for apps, updates, device management and IT support."
                         Foreground="#68778D"
                         FontSize="12" />
            </StackPanel>
            <Grid x:Name="HomeSummaryPanel" ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <Border Grid.Column="0"
                      Classes="panel"
                      Background="#EFFAF5"
                      BorderBrush="#CCECDD"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="22" Background="#19A46B">
                    <TextBlock Text="✓" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceHealthTitle"
                               Text="Device Healthy"
                               Foreground="#17233A"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="DeviceHealthSubtitle"
                               Text="Connected and managed"
                               Foreground="#62778C"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="1"
                      Classes="panel"
                      Background="#F2F7FF"
                      BorderBrush="#D5E4FB"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="22" Background="#E4F0FF">
                    <TextBlock Text="↻" Foreground="#0876E8" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock x:Name="UpdatesCountText" Text="0" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="Updates Available" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="UpdatesSummaryText"
                               Text="0 Windows  |  0 Application"
                               Foreground="#62778C"
                               FontSize="9" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="2"
                      Classes="panel"
                      Background="#FFF7E9"
                      BorderBrush="#F5E0B7"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="12" Background="#FFF0D1">
                    <PathIcon Width="22" Height="22" Foreground="#C95F00"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M7 12.25C7 11.8358 7.33579 11.5 7.75 11.5C8.16421 11.5 8.5 11.8358 8.5 12.25C8.5 12.6642 8.16421 13 7.75 13C7.33579 13 7 12.6642 7 12.25ZM7.75 14.5C7.33579 14.5 7 14.8358 7 15.25C7 15.6642 7.33579 16 7.75 16C8.16421 16 8.5 15.6642 8.5 15.25C8.5 14.8358 8.16421 14.5 7.75 14.5ZM7 18.25C7 17.8358 7.33579 17.5 7.75 17.5C8.16421 17.5 8.5 17.8358 8.5 18.25C8.5 18.6642 8.16421 19 7.75 19C7.33579 19 7 18.6642 7 18.25ZM10.75 11.5C10.3358 11.5 10 11.8358 10 12.25C10 12.6642 10.3358 13 10.75 13H16.25C16.6642 13 17 12.6642 17 12.25C17 11.8358 16.6642 11.5 16.25 11.5H10.75ZM10 15.25C10 14.8358 10.3358 14.5 10.75 14.5H16.25C16.6642 14.5 17 14.8358 17 15.25C17 15.6642 16.6642 16 16.25 16H10.75C10.3358 16 10 15.6642 10 15.25ZM10.75 17.5C10.3358 17.5 10 17.8358 10 18.25C10 18.6642 10.3358 19 10.75 19H16.25C16.6642 19 17 18.6642 17 18.25C17 17.8358 16.6642 17.5 16.25 17.5H10.75ZM19.414 8.414L13.585 2.586C13.2194 2.22035 12.6865 2 12.172 2H6C4.896 2 4 2.896 4 4V20C4 21.104 4.896 22 6 22H18C19.104 22 20 21.104 20 20V9.828C20 9.298 19.789 8.789 19.414 8.414ZM18.5 20C18.5 20.275 18.276 20.5 18 20.5H6C5.724 20.5 5.5 20.275 5.5 20V4C5.5 3.725 5.724 3.5 6 3.5H12V8C12 9.104 12.896 10 14 10H18.5V20ZM13.5 4.621L17.378 8.5H14C13.724 8.5 13.5 8.275 13.5 8V4.621Z" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock x:Name="PendingRequestCountText" Text="0"
                                 Foreground="#17233A" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="Pending Request" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="PendingRequestSummaryText"
                               Text="No requests awaiting approval"
                               Foreground="#62778C"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="3"
                      Classes="panel"
                      Background="#F7F1FF"
                      BorderBrush="#E7D7FA"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="12" Background="#EFE3FF">
                    <PathIcon Width="22" Height="22" Foreground="#7B35D5"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M18.4923 2.33088L21.671 5.50966C22.5497 6.38834 22.5497 7.81296 21.671 8.69164L19.0866 11.2756C20.1696 11.438 21 12.3723 21 13.5006V18.7506C21 19.9932 19.9926 21.0006 18.75 21.0006H5.25C4.00736 21.0006 3 19.9932 3 18.7506V5.25055C3 4.00791 4.00736 3.00055 5.25 3.00055H10.5C11.6289 3.00055 12.5637 3.83201 12.7253 4.91596L15.3103 2.33088C16.189 1.45221 17.6136 1.45221 18.4923 2.33088ZM4.5 18.7506C4.5 19.1648 4.83579 19.5006 5.25 19.5006L11.249 19.4999L11.25 12.7506L4.5 12.7499V18.7506ZM12.749 19.4999L18.75 19.5006C19.1642 19.5006 19.5 19.1648 19.5 18.7506V13.5006C19.5 13.0863 19.1642 12.7506 18.75 12.7506L12.749 12.7499V19.4999ZM10.5 4.50055H5.25C4.83579 4.50055 4.5 4.83634 4.5 5.25055V11.2499H11.25V5.25055C11.25 4.83634 10.9142 4.50055 10.5 4.50055ZM12.75 9.30988V11.2506L14.69 11.2499L12.75 9.30988ZM16.3709 3.39154L13.1922 6.57032C12.8993 6.86321 12.8993 7.33808 13.1922 7.63098L16.3709 10.8097C16.6638 11.1026 17.1387 11.1026 17.4316 10.8097L20.6104 7.63098C20.9033 7.33808 20.9033 6.86321 20.6104 6.57032L17.4316 3.39154C17.1387 3.09865 16.6638 3.09865 16.3709 3.39154Z" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock x:Name="AvailableCountText"
                                 Text="0"
                                 Foreground="#17233A"
                                 FontSize="12"
                                 FontWeight="Bold" />
                      <TextBlock Text="Available Apps" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Browse the software catalogue"
                               Foreground="#62778C"
                               FontSize="9" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
            <Border x:Name="AppCataloguePanel" Classes="panel" Padding="14">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="AppsSectionTitle" Text="Featured Apps" Classes="sectionTitle" VerticalAlignment="Center" />
                    <TextBlock x:Name="ResultCountText"
                               Text="0 apps"
                               Classes="muted"
                               IsVisible="False"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <StackPanel x:Name="AppTabsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="AppTabAll"
                            Classes="tab active"
                            Tag="all"
                            Content="All Apps"
                            Click="AppSectionButton_Click" />
                    <Button x:Name="AppTabCompany"
                            Classes="tab"
                            Tag="company"
                            Content="Company Apps"
                            Click="AppSectionButton_Click" />
                    <Button x:Name="AppTabPopular"
                            Classes="tab"
                            Tag="popular"
                            Content="Popular"
                            Click="AppSectionButton_Click" />
                    <ComboBox x:Name="CategoryCombo"
                              Width="118"
                              SelectionChanged="CategoryCombo_SelectionChanged"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#596A80"
                              FontSize="9"
                              Padding="6,4" />
                    <Button Content="View All Apps  →"
                            Classes="tab"
                            Click="ViewAllApps_Click" />
                    <Button x:Name="RefreshButton"
                            IsVisible="False"
                            Click="RefreshButton_Click" />
                  </StackPanel>
                </Grid>

                <Grid>
                  <Border x:Name="AppsScroll">
                    <ItemsControl x:Name="AppsItems">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AppCard">
                          <Border Width="262"
                                  MinHeight="145"
                                  Margin="0,0,10,10"
                                  Padding="13"
                                  Background="#FFFFFF"
                                  BorderBrush="#E1E8F1"
                                  BorderThickness="1"
                                  CornerRadius="10">
                            <Grid RowDefinitions="Auto,*,Auto">
                              <Grid Grid.Row="0" ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="10"
                                        Background="#EEF4FF"
                                        BorderBrush="#D7E5FA"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                  <Grid>
                                    <Image Source="{Binding IconImage}"
                                           IsVisible="{Binding HasIcon}"
                                           Stretch="Uniform"
                                           Margin="5" />
                                    <TextBlock Text="{Binding Initials}"
                                               IsVisible="{Binding ShowFallbackIcon}"
                                               Foreground="#245899"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}"
                                             Foreground="#17233A"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Publisher}"
                                             Foreground="#738298"
                                             FontSize="9"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="•••"
                                           Foreground="#6E7E93"
                                           FontSize="11"
                                           VerticalAlignment="Top" />
                              </Grid>
                              <TextBlock Grid.Row="1"
                                         Text="{Binding Description}"
                                         Margin="0,10,0,8"
                                         Foreground="#55677E"
                                         FontSize="9"
                                         LineHeight="14"
                                         MaxHeight="42"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis" />
                              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                  <Border Background="{Binding StatusBackground}"
                                          CornerRadius="8"
                                          Padding="6,3">
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{Binding StatusForeground}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                  </Border>
                                  <TextBlock Text="{Binding Version}"
                                             Foreground="#8A97A9"
                                             FontSize="8"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Content="{Binding ActionText}"
                                        IsEnabled="{Binding CanInstall}"
                                        Click="InstallButton_Click"
                                        MinWidth="75" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border x:Name="EmptyState"
                          IsVisible="False"
                          Background="#FBFCFE"
                          BorderBrush="#D9E3EF"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="24"
                          MinHeight="150">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="430"
                                Spacing="6">
                      <Border Width="48" Height="48" CornerRadius="13" Background="#EAF3FF"
                              HorizontalAlignment="Center">
                        <TextBlock Text="H5" Foreground="#1769D2" FontWeight="Black" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock x:Name="EmptyTitle"
                                 Text="No software has been assigned yet"
                                 Foreground="#17233A"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center" />
                      <TextBlock x:Name="EmptyDescription"
                                 Text="Your IT team can publish approved applications to this portal."
                                 Foreground="#748399"
                                 FontSize="9"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
            <Grid x:Name="HomeOverviewPanel" ColumnDefinitions="1.05*,1.05*,0.95*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="panel" Padding="13">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Recent Requests" Classes="sectionTitle" />
                    <TextBlock Grid.Column="1" Text="View All  →"
                               Foreground="#0969DA" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl x:Name="RecentRequestItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RequestSummaryItem">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="0,4">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#26354E"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Software request"
                                       Foreground="#8A97A9"
                                       FontSize="8" />
                          </StackPanel>
                          <Border Grid.Column="1"
                                  Background="{Binding StatusBackground}"
                                  CornerRadius="8"
                                  Padding="7,3"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusForeground}"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                          </Border>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding DateText}"
                                     Foreground="#8997A9"
                                     FontSize="8"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="NoRequestsText"
                              IsVisible="False"
                              Margin="0,18,0,14"
                              Spacing="4"
                              HorizontalAlignment="Center">
                    <TextBlock Text="No software requests yet"
                               Foreground="#42546B"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Approval requests will appear here."
                               Foreground="#8A97A9"
                               FontSize="8"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="panel" Padding="13">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Updates" Classes="sectionTitle" />
                    <TextBlock Grid.Column="1" Text="View All  →"
                               Foreground="#0969DA" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl x:Name="DashboardUpdateItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:DashboardUpdateItem">
                        <Grid ColumnDefinitions="30,*,Auto"
                              ColumnSpacing="8"
                              Margin="0,4">
                          <Border Width="28" Height="28"
                                  CornerRadius="7"
                                  Background="#EAF3FF">
                            <TextBlock Text="{Binding IconText}"
                                       Foreground="#1769D2"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#26354E"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}"
                                       Foreground="#8A97A9"
                                       FontSize="8"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2"
                                  Background="{Binding StatusBackground}"
                                  CornerRadius="8"
                                  Padding="7,3"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusForeground}"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="NoUpdatesText"
                              IsVisible="False"
                              Margin="0,18,0,14"
                              Spacing="4"
                              HorizontalAlignment="Center">
                    <TextBlock Text="You're up to date"
                               Foreground="#42546B"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No Windows or application updates are pending."
                               Foreground="#8A97A9"
                               FontSize="8"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="panel" Padding="13">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="My Device" Classes="sectionTitle" />
                    <TextBlock Grid.Column="1" Text="View Details  →"
                               Foreground="#0969DA" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
                    <Border Width="70" Height="54" CornerRadius="8" Background="#EAF3FF">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                        <PathIcon Width="28" Height="28" Foreground="#1769D2"
                                  HorizontalAlignment="Center"
                                  Data="M6.25 4C5.00736 4 4 5.00736 4 6.25V13.75C4 14.9926 5.00736 16 6.25 16H17.75C18.9926 16 20 14.9926 20 13.75V6.25C20 5.00736 18.9926 4 17.75 4H6.25ZM5.5 6.25C5.5 5.83579 5.83579 5.5 6.25 5.5H17.75C18.1642 5.5 18.5 5.83579 18.5 6.25V13.75C18.5 14.1642 18.1642 14.5 17.75 14.5H6.25C5.83579 14.5 5.5 14.1642 5.5 13.75V6.25ZM2.75 17.5C2.33579 17.5 2 17.8358 2 18.25C2 18.6642 2.33579 19 2.75 19H21.25C21.6642 19 22 18.6642 22 18.25C22 17.8358 21.6642 17.5 21.25 17.5H2.75Z" />
                        <TextBlock Text="Hi5" FontSize="8" Foreground="#58718B"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock x:Name="DeviceNameText"
                                 Text="This device"
                                 Foreground="#17233A"
                                 FontWeight="Bold"
                                 FontSize="10" />
                      <TextBlock x:Name="DeviceModelText"
                                 Text="Managed endpoint"
                                 Foreground="#748399"
                                 FontSize="8"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="5">
                    <TextBlock Grid.Row="0" Text="Operating System" Classes="muted" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceOsText"
                               Text="Windows" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="1" Text="Device Health" Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceHealthText"
                               Text="Connected" Foreground="#16825F" FontSize="9" />
                    <TextBlock Grid.Row="2" Text="Encryption" Classes="muted" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DeviceEncryptionText"
                               Text="Not reported" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="3" Text="Last Sync" Classes="muted" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DeviceLastSyncText"
                               Text="Not reported" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="4" Text="Storage" Classes="muted" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DeviceStorageText"
                               Text="Not reported" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="5" Text="Assigned User" Classes="muted" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DeviceUserText"
                               Text="Signed-in user" Foreground="#34445C" FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
            <Border x:Name="HomeSupportPanel" Classes="panel" Padding="13">
              <Grid ColumnDefinitions="175,*,*,*,*" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Help &amp; Support" Classes="sectionTitle" />
                  <TextBlock Text="Get help from the IT team or find useful resources."
                             Foreground="#7E8CA0"
                             FontSize="8"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Request Remote Help   ›" />
                <Button Grid.Column="2" Classes="ghost" Content="Open Ticket   ›" />
                <Button Grid.Column="3" Classes="ghost" Content="Knowledge Base   ›" />
                <Button Grid.Column="4" Classes="ghost" Content="Chat with IT   ›" />
              </Grid>
            </Border>

            <StackPanel x:Name="UpdatesPagePanel" IsVisible="False" Spacing="12">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="panel" Padding="16">
                  <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#EAF3FF">
                      <TextBlock Text="W" Foreground="#1769D2" FontSize="16" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock x:Name="UpdatesPageWindowsCountText" Text="0"
                                 Foreground="#17233A" FontSize="20" FontWeight="Bold" />
                      <TextBlock Text="Windows updates" Foreground="#6E7E93" FontSize="9" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Grid.Column="1" Classes="panel" Padding="16">
                  <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#F1ECFF">
                      <TextBlock Text="A" Foreground="#7552C8" FontSize="16" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                      <TextBlock x:Name="UpdatesPageSoftwareCountText" Text="0"
                                 Foreground="#17233A" FontSize="20" FontWeight="Bold" />
                      <TextBlock Text="Application updates" Foreground="#6E7E93" FontSize="9" />
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <Border Classes="panel" Padding="15">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Available updates" Classes="sectionTitle" />
                      <TextBlock Text="Updates detected by Windows Update and PatchHost on this device."
                                 Foreground="#7C899D" FontSize="9" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="9" Padding="9,5"
                            VerticalAlignment="Center">
                      <TextBlock Text="Managed by your IT team" Foreground="#1769D2"
                                 FontSize="8" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                  <ItemsControl x:Name="UpdatesPageItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:DashboardUpdateItem">
                        <Border BorderBrush="#E6EBF2" BorderThickness="0,1,0,0" Padding="0,10">
                          <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="10">
                            <Border Width="34" Height="34" CornerRadius="9" Background="#EAF3FF">
                              <TextBlock Text="{Binding IconText}" Foreground="#1769D2"
                                         FontWeight="Bold" FontSize="11"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" Foreground="#1B2B43"
                                         FontSize="10" FontWeight="SemiBold"
                                         TextTrimming="CharacterEllipsis" />
                              <TextBlock Text="{Binding Detail}" Foreground="#7B899D"
                                         FontSize="8" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border Grid.Column="2" Background="{Binding StatusBackground}"
                                    CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                         FontSize="8" FontWeight="SemiBold" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="UpdatesPageEmpty" IsVisible="False"
                              HorizontalAlignment="Center" Margin="0,28,0,24" Spacing="4">
                    <TextBlock Text="You're up to date" Foreground="#31445E"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="No Windows or application updates are currently pending."
                               Foreground="#8491A4" FontSize="9" HorizontalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="RequestsPagePanel" IsVisible="False" Spacing="12">
              <Border Classes="panel" Padding="15">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Software requests" Classes="sectionTitle" />
                      <TextBlock Text="Track approval requests and completed software fulfilment."
                                 Foreground="#7C899D" FontSize="9" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FFF7E8" CornerRadius="9" Padding="9,5"
                            VerticalAlignment="Center">
                      <TextBlock Text="IT approval workflow" Foreground="#A56400"
                                 FontSize="8" FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                  <ItemsControl x:Name="RequestsPageItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RequestSummaryItem">
                        <Border BorderBrush="#E6EBF2" BorderThickness="0,1,0,0" Padding="0,11">
                          <Grid ColumnDefinitions="*,Auto,100" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" Foreground="#1B2B43"
                                         FontSize="10" FontWeight="SemiBold" />
                              <TextBlock Text="Software request" Foreground="#8794A7" FontSize="8" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{Binding StatusBackground}"
                                    CornerRadius="9" Padding="8,4" VerticalAlignment="Center">
                              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}"
                                         FontSize="8" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Foreground="#8794A7"
                                       FontSize="8" VerticalAlignment="Center" HorizontalAlignment="Right" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel x:Name="RequestsPageEmpty" IsVisible="False"
                              HorizontalAlignment="Center" Margin="0,30,0,24" Spacing="4">
                    <TextBlock Text="No requests yet" Foreground="#31445E"
                               FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Applications requiring approval will appear here after you request them."
                               Foreground="#8491A4" FontSize="9" HorizontalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="DevicePagePanel" IsVisible="False" Spacing="12">
              <Border Classes="panel" Padding="18">
                <Grid ColumnDefinitions="110,*" ColumnSpacing="18">
                  <Border Width="104" Height="82" CornerRadius="14" Background="#EAF3FF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                      <PathIcon Width="34" Height="34" Foreground="#1769D2"
                                Data="M6.25 4C5.00736 4 4 5.00736 4 6.25V13.75C4 14.9926 5.00736 16 6.25 16H17.75C18.9926 16 20 14.9926 20 13.75V6.25C20 5.00736 18.9926 4 17.75 4H6.25ZM5.5 6.25C5.5 5.83579 5.83579 5.5 6.25 5.5H17.75C18.1642 5.5 18.5 5.83579 18.5 6.25V13.75C18.5 14.1642 18.1642 14.5 17.75 14.5H6.25C5.83579 14.5 5.5 14.1642 5.5 13.75V6.25ZM2.75 17.5C2.33579 17.5 2 17.8358 2 18.25C2 18.6642 2.33579 19 2.75 19H21.25C21.6642 19 22 18.6642 22 18.25C22 17.8358 21.6642 17.5 21.25 17.5H2.75Z" />
                      <TextBlock Text="Managed device" Foreground="#67809A" FontSize="8" />
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="DevicePageNameText" Text="This device"
                               Foreground="#15233A" FontSize="18" FontWeight="Bold" />
                    <TextBlock x:Name="DevicePageModelText" Text="Managed endpoint"
                               Foreground="#738298" FontSize="10" />
                    <Border Background="#EAF8F2" CornerRadius="9" Padding="8,4"
                            HorizontalAlignment="Left">
                      <TextBlock x:Name="DevicePageHealthText" Text="Connected"
                                 Foreground="#16825F" FontSize="8" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                </Grid>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="panel" Padding="16">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Device information" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10">
                      <TextBlock Grid.Row="0" Text="Operating system" Classes="muted" />
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DevicePageOsText"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="1" Text="Encryption" Classes="muted" />
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevicePageEncryptionText"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="2" Text="Storage" Classes="muted" />
                      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DevicePageStorageText"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="3" Text="Assigned user" Classes="muted" />
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DevicePageUserText"
                                 Foreground="#31445E" FontSize="9" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="panel" Padding="16">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Hi5Central management" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="145,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                      <TextBlock Grid.Row="0" Text="Last sync" Classes="muted" />
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DevicePageLastSyncText"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="1" Text="Agent version" Classes="muted" />
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DevicePageAgentText"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="2" Text="Management state" Classes="muted" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="Managed by Hi5Central"
                                 Foreground="#16825F" FontSize="9" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <StackPanel x:Name="SupportPagePanel" IsVisible="False" Spacing="12">
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <Border Grid.Row="0" Grid.Column="0" Classes="panel" Padding="17">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Remote assistance" Classes="sectionTitle" />
                    <TextBlock Text="Connect with your IT team for live remote support when your organisation enables it."
                               Foreground="#748399" FontSize="9" TextWrapping="Wrap" />
                    <Button Classes="ghost" Content="Request Remote Help" IsEnabled="False"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="Support workflow not configured yet" Foreground="#9AA6B7" FontSize="8" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Classes="panel" Padding="17">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Service desk" Classes="sectionTitle" />
                    <TextBlock Text="Raise an IT request and follow its progress from Self Service."
                               Foreground="#748399" FontSize="9" TextWrapping="Wrap" />
                    <Button Classes="ghost" Content="Open Ticket" IsEnabled="False"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="ITSM integration will appear here when enabled" Foreground="#9AA6B7" FontSize="8" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Classes="panel" Padding="17">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Knowledge base" Classes="sectionTitle" />
                    <TextBlock Text="Find company guidance, common fixes and approved self-help articles."
                               Foreground="#748399" FontSize="9" TextWrapping="Wrap" />
                    <Button Classes="ghost" Content="Browse Knowledge Base" IsEnabled="False"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="Knowledge content not configured yet" Foreground="#9AA6B7" FontSize="8" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Classes="panel" Padding="17">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Contact IT" Classes="sectionTitle" />
                    <TextBlock Text="Your organisation can expose chat, contact details or escalation options here."
                               Foreground="#748399" FontSize="9" TextWrapping="Wrap" />
                    <Button Classes="ghost" Content="Chat with IT" IsEnabled="False"
                            HorizontalAlignment="Left" />
                    <TextBlock Text="Chat integration not configured yet" Foreground="#9AA6B7" FontSize="8" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <StackPanel x:Name="SettingsPagePanel" IsVisible="False" Spacing="12">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Border Grid.Column="0" Classes="panel" Padding="17">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Self Service" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                      <TextBlock Grid.Row="0" Text="Portal version" Classes="muted" />
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SettingsPortalVersionText"
                                 Text="Development" Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="1" Text="Agent version" Classes="muted" />
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SettingsAgentVersionText"
                                 Text="Not reported" Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="2" Text="Update channel" Classes="muted" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="Managed by Hi5Central"
                                 Foreground="#31445E" FontSize="9" />
                    </Grid>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="panel" Padding="17">
                  <StackPanel Spacing="12">
                    <TextBlock Text="Runtime behaviour" Classes="sectionTitle" />
                    <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                      <TextBlock Grid.Row="0" Text="Catalogue refresh" Classes="muted" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="Automatic during active jobs"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="1" Text="Application icons" Classes="muted" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Text="Cached locally on demand"
                                 Foreground="#31445E" FontSize="9" />
                      <TextBlock Grid.Row="2" Text="Install elevation" Classes="muted" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="Handled by Hi5Central Agent"
                                 Foreground="#16825F" FontSize="9" />
                    </Grid>
                  </StackPanel>
                </Border>
              </Grid>
              <Border Classes="panel" Padding="17">
                <StackPanel Spacing="4">
                  <TextBlock Text="About Hi5 Self Service" Classes="sectionTitle" />
                  <TextBlock Text="Self Service runs as an unprivileged desktop application. Software installation and other privileged operations are handed to the Hi5Central Agent and PatchHost."
                             Foreground="#748399" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="LoadingOverlay"
                Background="#EAF4F7FB"
                IsVisible="True">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="250"
                      Spacing="10">
            <ProgressBar IsIndeterminate="True" Height="5" />
            <TextBlock Text="Loading Hi5 Self Service..."
                       Foreground="#66778E"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="StatusBanner"
                IsVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="420"
                Margin="0,0,18,18"
                Padding="12,10"
                CornerRadius="10"
                Background="#EAF8F2"
                BorderBrush="#C5EBDD"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock x:Name="StatusTitle"
                         Text="Done"
                         Foreground="#146B50"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock x:Name="StatusMessage"
                         Foreground="#5E6D7F"
                         FontSize="9"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="×"
                    Click="DismissStatus_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#5E6D7F"
                    FontSize="15" />
          </Grid>
        </Border>

        <TextBlock x:Name="AgentStatusText"
                   IsVisible="False"
                   Text="Connected through Hi5Central Agent" />
      </Grid>
    </Grid>
  </Grid>
</Window>