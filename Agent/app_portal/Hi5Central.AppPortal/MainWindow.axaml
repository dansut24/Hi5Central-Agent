<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Hi5Central.AppPortal.Models"
        x:Class="Hi5Central.AppPortal.MainWindow"
        Title="Hi5 Self Service"
        Width="1440"
        Height="820"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#30415F" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EAF3FF" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#DCEEFF" />
      <Setter Property="Foreground" Value="#0C67D9" />
    </Style>    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0969DA" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0459BC" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.46" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#F7FAFE" />
      <Setter Property="Foreground" Value="#0969DA" />
      <Setter Property="BorderBrush" Value="#CFE0F6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#596A80" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="7,7,7,6" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tab.active">
      <Setter Property="Foreground" Value="#0969DA" />
      <Setter Property="BorderBrush" Value="#0969DA" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F6F9FD" />
    </Style>
    <Style Selector="Border.panel">      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DFE7F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="#17233A" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#718096" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="206,*">
    <Border Grid.Column="0"
            Background="#F8FBFF"
            BorderBrush="#DFE7F1"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,18,14,16">
        <StackPanel Grid.Row="0" Spacing="20">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,2,0,8">
            <Border Width="38" Height="38" CornerRadius="10" Background="#0876E8">              <TextBlock Text="H5"
                         Foreground="White"
                         FontSize="15"
                         FontWeight="Black"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Hi5Central"
                       Foreground="#15213A"
                       FontSize="17"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Button x:Name="NavHome" Classes="nav active" Tag="home" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Width="18" Height="18" Data="M10.5495 2.53189C11.3874 1.82531 12.6126 1.82531 13.4505 2.5319L20.2005 8.224C20.7074 8.65152 21 9.2809 21 9.94406L21 19.2539C21 20.2204 20.2165 21.0039 19.25 21.0039H15.75C14.7835 21.0039 14 20.2204 14 19.2539L14 14.2468C14 14.1088 13.8881 13.9968 13.75 13.9968H10.25C10.1119 13.9968 9.99999 14.1088 9.99999 14.2468L9.99999 19.2539C9.99999 20.2204 9.2165 21.0039 8.25 21.0039H4.75C3.7835 21.0039 3 20.2204 3 19.2539V9.94406C3 9.2809 3.29255 8.65152 3.79952 8.224L10.5495 2.53189ZM12.4835 3.6786C12.2042 3.44307 11.7958 3.44307 11.5165 3.6786L4.76651 9.37071C4.59752 9.51321 4.5 9.72301 4.5 9.94406L4.5 19.2539C4.5 19.392 4.61193 19.5039 4.75 19.5039H8.25C8.38807 19.5039 8.49999 19.392 8.49999 19.2539L8.49999 14.2468C8.49999 13.2803 9.2835 12.4968 10.25 12.4968H13.75C14.7165 12.4968 15.5 13.2803 15.5 14.2468L15.5 19.2539C15.5 19.392 15.6119 19.5039 15.75 19.5039H19.25C19.3881 19.5039 19.5 19.392 19.5 19.2539L19.5 9.94406C19.5 9.72301 19.4025 9.51321 19.2335 9.37071L12.4835 3.6786Z" />
                <TextBlock Text="Home" />
              </StackPanel>
            </Button>
            <Button x:Name="NavAll" Classes="nav" Tag="all" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Width="18" Height="18" Data="M18.4923 2.33088L21.671 5.50966C22.5497 6.38834 22.5497 7.81296 21.671 8.69164L19.0866 11.2756C20.1696 11.438 21 12.3723 21 13.5006V18.7506C21 19.9932 19.9926 21.0006 18.75 21.0006H5.25C4.00736 21.0006 3 19.9932 3 18.7506V5.25055C3 4.00791 4.00736 3.00055 5.25 3.00055H10.5C11.6289 3.00055 12.5637 3.83201 12.7253 4.91596L15.3103 2.33088C16.189 1.45221 17.6136 1.45221 18.4923 2.33088ZM4.5 18.7506C4.5 19.1648 4.83579 19.5006 5.25 19.5006L11.249 19.4999L11.25 12.7506L4.5 12.7499V18.7506ZM12.749 19.4999L18.75 19.5006C19.1642 19.5006 19.5 19.1648 19.5 18.7506V13.5006C19.5 13.0863 19.1642 12.7506 18.75 12.7506L12.749 12.7499V19.4999ZM10.5 4.50055H5.25C4.83579 4.50055 4.5 4.83634 4.5 5.25055V11.2499H11.25V5.25055C11.25 4.83634 10.9142 4.50055 10.5 4.50055ZM12.75 9.30988V11.2506L14.69 11.2499L12.75 9.30988ZM16.3709 3.39154L13.1922 6.57032C12.8993 6.86321 12.8993 7.33808 13.1922 7.63098L16.3709 10.8097C16.6638 11.1026 17.1387 11.1026 17.4316 10.8097L20.6104 7.63098C20.9033 7.33808 20.9033 6.86321 20.6104 6.57032L17.4316 3.39154C17.1387 3.09865 16.6638 3.09865 16.3709 3.39154Z" />
                <TextBlock Text="Apps" />
              </StackPanel>
            </Button>
            <Button x:Name="NavUpdates" Classes="nav" Tag="updates" Click="NavButton_Click">              <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12">
                <PathIcon Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center" Data="M18.2498 20.5009C18.664 20.5008 19 20.8365 19 21.2507C19 21.6649 18.6644 22.0008 18.2502 22.0009L5.25022 22.0047C4.836 22.0048 4.5 21.6691 4.5 21.2549C4.5 20.8407 4.83557 20.5048 5.24978 20.5047L18.2498 20.5009ZM11.6482 2.01271L11.75 2.00586C12.1297 2.00586 12.4435 2.28801 12.4932 2.65409L12.5 2.75586L12.499 16.4409L16.2208 12.7205C16.4871 12.4543 16.9038 12.4301 17.1974 12.648L17.2815 12.7206C17.5477 12.9869 17.5719 13.4036 17.354 13.6972L17.2814 13.7813L12.2837 18.7779C12.0176 19.044 11.6012 19.0683 11.3076 18.8507L11.2235 18.7782L6.22003 13.7816C5.92694 13.4889 5.92661 13.014 6.21931 12.7209C6.48539 12.4545 6.90204 12.43 7.1958 12.6477L7.27997 12.7202L10.999 16.4339L11 2.75586C11 2.37616 11.2822 2.06237 11.6482 2.01271L11.75 2.00586L11.6482 2.01271Z" />
                <TextBlock Grid.Column="1"
                           Text="Updates"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Height="20"
                        MinWidth="20"
                        Padding="5,0"
                        Background="#0876E8"
                        CornerRadius="10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                  <TextBlock x:Name="SidebarUpdateCountText"
                             Text="0"
                             Foreground="White"
                             FontSize="9"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center" />
                </Border>
              </Grid>
            </Button>
            <Button x:Name="NavInstalled" Classes="nav" Tag="installed" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
