<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Hi5Central.AppPortal.Models"
        x:Class="Hi5Central.AppPortal.MainWindow"
        Title="Hi5 Self Service"
        Width="1450"
        Height="900"
        MinWidth="1050"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#30415F" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EAF3FF" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#DCEEFF" />
      <Setter Property="Foreground" Value="#0C67D9" />
    </Style>    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0969DA" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0459BC" />
    </Style>
    <Style Selector="Button.primary:disabled">
      <Setter Property="Opacity" Value="0.46" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="#F7FAFE" />
      <Setter Property="Foreground" Value="#0969DA" />
      <Setter Property="BorderBrush" Value="#CFE0F6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Border.panel">      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#DFE7F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="#17233A" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#718096" />
      <Setter Property="FontSize" Value="10" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="206,*">
    <Border Grid.Column="0"
            Background="#F8FBFF"
            BorderBrush="#DFE7F1"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="16,18,14,16">
        <StackPanel Grid.Row="0" Spacing="20">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,2,0,8">
            <Border Width="38" Height="38" CornerRadius="10" Background="#0876E8">              <TextBlock Text="H5"
                         Foreground="White"
                         FontSize="15"
                         FontWeight="Black"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Hi5Central"
                       Foreground="#15213A"
                       FontSize="17"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="5">
            <Button x:Name="NavHome" Classes="nav active" Tag="home" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="⌂" FontSize="17" Width="20" TextAlignment="Center" />
                <TextBlock Text="Home" />
              </StackPanel>
            </Button>
            <Button x:Name="NavAll" Classes="nav" Tag="all" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="▦" FontSize="15" Width="20" TextAlignment="Center" />
                <TextBlock Text="Apps" />
              </StackPanel>
            </Button>
            <Button x:Name="NavUpdates" Classes="nav" Tag="updates" Click="NavButton_Click">              <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="↓" FontSize="16" TextAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Updates" />
                <Border Grid.Column="2" Background="#0876E8" CornerRadius="10" Padding="6,2">
                  <TextBlock x:Name="SidebarUpdateCountText"
                             Text="0"
                             Foreground="White"
                             FontSize="9"
                             FontWeight="Bold" />
                </Border>
              </Grid>
            </Button>
            <Button x:Name="NavInstalled" Classes="nav" Tag="installed" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="▣" FontSize="14" Width="20" TextAlignment="Center" />
                <TextBlock Text="Installed" />
              </StackPanel>
            </Button>
            <Button x:Name="NavRequests" Classes="nav" Tag="requests" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="▤" FontSize="14" Width="20" TextAlignment="Center" />
                <TextBlock Text="Requests" />
              </StackPanel>
            </Button>            <Button x:Name="NavDevice" Classes="nav" Tag="device" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="▱" FontSize="15" Width="20" TextAlignment="Center" />
                <TextBlock Text="My Device" />
              </StackPanel>
            </Button>
            <Button x:Name="NavSupport" Classes="nav" Tag="support" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="?" FontSize="14" Width="20" TextAlignment="Center" />
                <TextBlock Text="Help &amp; Support" />
              </StackPanel>
            </Button>
            <Button x:Name="NavSettings" Classes="nav" Tag="settings" Click="NavButton_Click">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="⚙" FontSize="14" Width="20" TextAlignment="Center" />
                <TextBlock Text="Settings" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="9" Margin="7,12,0,2">
          <TextBlock Text="Hi5 Self Service" Foreground="#7A899F" FontSize="9" />
          <TextBlock Text="Powered by Hi5Central" Foreground="#91A0B5" FontSize="8" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="68,*">
      <Border Grid.Row="0"
              Background="#FBFDFF"
              BorderBrush="#DFE7F1"
              BorderThickness="0,0,0,1"
              Padding="22,13">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="18">
          <TextBox x:Name="SearchBox"
                   Grid.Column="0"
                   MaxWidth="500"
                   HorizontalAlignment="Left"
                   Watermark="Search for apps, tools, or help..."
                   TextChanged="SearchBox_TextChanged"
                   Background="White"
                   BorderBrush="#D5DFEC"
                   BorderThickness="1"
                   CornerRadius="8"
                   Padding="12,8" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="●" Foreground="#D83939" FontSize="10" VerticalAlignment="Top" />
            <TextBlock Text="▱" Foreground="#31445F" FontSize="22" VerticalAlignment="Center" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock x:Name="HeaderDeviceNameText"
                         Text="This device"
                         Foreground="#17233A"
                         FontSize="10"
                         FontWeight="Bold" />
              <StackPanel Orientation="Horizontal" Spacing="5">
                <TextBlock Text="●" Foreground="#22A06B" FontSize="8" />
                <TextBlock x:Name="HeaderDeviceStateText" Text="Online" Classes="muted" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <Border Width="36" Height="36" CornerRadius="18" Background="#126DDC">
              <TextBlock x:Name="HeaderUserInitialsText"
                         Text="H5"
                         Foreground="White"
                         FontSize="11"
                         FontWeight="Bold"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center" MinWidth="100">
              <TextBlock x:Name="HeaderUserText"
                         Text="Signed-in user"
                         Foreground="#17233A"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock Text="Self Service" Classes="muted" />
            </StackPanel>
            <TextBlock Text="⌄" Foreground="#66768B" FontSize="14" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="22,18,22,26" Spacing="15">
            <StackPanel Spacing="2">
              <TextBlock x:Name="HeroEyebrow" IsVisible="False" />
              <TextBlock x:Name="HeroTitle"
                         Text="Hi5 Self Service"
                         Foreground="#111A2D"
                         FontSize="31"
                         FontWeight="Bold" />
              <TextBlock x:Name="HeroDescription"
                         Text="Your one stop for apps, updates, device management and IT support."
                         Foreground="#68778D"
                         FontSize="12" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <Border Grid.Column="0"
                      Classes="panel"
                      Background="#EFFAF5"
                      BorderBrush="#CCECDD"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="22" Background="#19A46B">
                    <TextBlock Text="✓" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="DeviceHealthTitle"
                               Text="Device Healthy"
                               Foreground="#17233A"
                               FontSize="12"
                               FontWeight="Bold" />
                    <TextBlock x:Name="DeviceHealthSubtitle"
                               Text="Connected and managed"
                               Foreground="#62778C"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="1"
                      Classes="panel"
                      Background="#F2F7FF"
                      BorderBrush="#D5E4FB"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="22" Background="#E4F0FF">
                    <TextBlock Text="↻" Foreground="#0876E8" FontSize="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock x:Name="UpdatesCountText" Text="0" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="Updates Available" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="UpdatesSummaryText"
                               Text="0 Windows  |  0 Application"
                               Foreground="#62778C"
                               FontSize="9" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="2"
                      Classes="panel"
                      Background="#FFF7E9"
                      BorderBrush="#F5E0B7"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="12" Background="#FFF0D1">
                    <TextBlock Text="▤" Foreground="#C95F00" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock x:Name="PendingRequestCountText" Text="0"
                                 Foreground="#17233A" FontSize="12" FontWeight="Bold" />
                      <TextBlock Text="Pending Request" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock x:Name="PendingRequestSummaryText"
                               Text="No requests awaiting approval"
                               Foreground="#62778C"
                               FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
              <Border Grid.Column="3"
                      Classes="panel"
                      Background="#F7F1FF"
                      BorderBrush="#E7D7FA"
                      Padding="16,14">
                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="11">
                  <Border Width="44" Height="44" CornerRadius="12" Background="#EFE3FF">
                    <TextBlock Text="▦" Foreground="#7B35D5" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock x:Name="AvailableCountText"
                                 Text="0"
                                 Foreground="#17233A"
                                 FontSize="12"
                                 FontWeight="Bold" />
                      <TextBlock Text="Available Apps" Foreground="#17233A"
                                 FontSize="12" FontWeight="Bold" />
                    </StackPanel>
                    <TextBlock Text="Browse the software catalogue"
                               Foreground="#62778C"
                               FontSize="9" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" Foreground="#45627F" FontSize="20"
                             VerticalAlignment="Center" />
                </Grid>
              </Border>
            </Grid>
            <Border Classes="panel" Padding="14">
              <StackPanel Spacing="11">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Featured Apps" Classes="sectionTitle" VerticalAlignment="Center" />
                    <TextBlock x:Name="ResultCountText"
                               Text="0 apps"
                               Classes="muted"
                               VerticalAlignment="Center" />
                  </StackPanel>
                  <ComboBox x:Name="CategoryCombo"
                            Grid.Column="1"
                            Width="170"
                            SelectionChanged="CategoryCombo_SelectionChanged"
                            Background="#F8FAFD"
                            BorderBrush="#D8E2EF"
                            CornerRadius="7"
                            Padding="8,6" />
                  <Button Grid.Column="2"
                          Content="Refresh"
                          x:Name="RefreshButton"
                          Classes="ghost"
                          Click="RefreshButton_Click" />
                </Grid>

                <Grid>
                  <Border x:Name="AppsScroll">
                    <ItemsControl x:Name="AppsItems">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:AppCard">
                          <Border Width="262"
                                  MinHeight="145"
                                  Margin="0,0,10,10"
                                  Padding="13"
                                  Background="#FFFFFF"
                                  BorderBrush="#E1E8F1"
                                  BorderThickness="1"
                                  CornerRadius="10">
                            <Grid RowDefinitions="Auto,*,Auto">
                              <Grid Grid.Row="0" ColumnDefinitions="46,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Width="44"
                                        Height="44"
                                        CornerRadius="10"
                                        Background="#EEF4FF"
                                        BorderBrush="#D7E5FA"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                  <Grid>
                                    <Image Source="{Binding IconImage}"
                                           IsVisible="{Binding HasIcon}"
                                           Stretch="Uniform"
                                           Margin="5" />
                                    <TextBlock Text="{Binding Initials}"
                                               IsVisible="{Binding ShowFallbackIcon}"
                                               Foreground="#245899"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                  </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}"
                                             Foreground="#17233A"
                                             FontSize="12"
                                             FontWeight="Bold"
                                             TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Publisher}"
                                             Foreground="#738298"
                                             FontSize="9"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="•••"
                                           Foreground="#6E7E93"
                                           FontSize="11"
                                           VerticalAlignment="Top" />
                              </Grid>
                              <TextBlock Grid.Row="1"
                                         Text="{Binding Description}"
                                         Margin="0,10,0,8"
                                         Foreground="#55677E"
                                         FontSize="9"
                                         LineHeight="14"
                                         MaxHeight="42"
                                         TextWrapping="Wrap"
                                         TextTrimming="CharacterEllipsis" />
                              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            Spacing="5"
                                            VerticalAlignment="Center">
                                  <Border Background="{Binding StatusBackground}"
                                          CornerRadius="8"
                                          Padding="6,3">
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{Binding StatusForeground}"
                                               FontSize="8"
                                               FontWeight="SemiBold" />
                                  </Border>
                                  <TextBlock Text="{Binding Version}"
                                             Foreground="#8A97A9"
                                             FontSize="8"
                                             VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Content="{Binding ActionText}"
                                        IsEnabled="{Binding CanInstall}"
                                        Click="InstallButton_Click"
                                        MinWidth="75" />
                              </Grid>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Border>
                  <Border x:Name="EmptyState"
                          IsVisible="False"
                          Background="#FBFCFE"
                          BorderBrush="#D9E3EF"
                          BorderThickness="1"
                          CornerRadius="10"
                          Padding="24"
                          MinHeight="150">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="430"
                                Spacing="6">
                      <Border Width="48" Height="48" CornerRadius="13" Background="#EAF3FF"
                              HorizontalAlignment="Center">
                        <TextBlock Text="H5" Foreground="#1769D2" FontWeight="Black" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock x:Name="EmptyTitle"
                                 Text="No software has been assigned yet"
                                 Foreground="#17233A"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center" />
                      <TextBlock x:Name="EmptyDescription"
                                 Text="Your IT team can publish approved applications to this portal."
                                 Foreground="#748399"
                                 FontSize="9"
                                 HorizontalAlignment="Center"
                                 TextAlignment="Center"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="1.05*,1.05*,0.95*" ColumnSpacing="12">
              <Border Grid.Column="0" Classes="panel" Padding="13">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Recent Requests" Classes="sectionTitle" />
                    <TextBlock Grid.Column="1" Text="View All  →"
                               Foreground="#0969DA" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl x:Name="RecentRequestItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:RequestSummaryItem">
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8"
                              Margin="0,4">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="#26354E"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Software request"
                                       Foreground="#8A97A9"
                                       FontSize="8" />
                          </StackPanel>
                          <Border Grid.Column="1"
                                  Background="{Binding StatusBackground}"
                                  CornerRadius="8"
                                  Padding="7,3"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusForeground}"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                          </Border>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding DateText}"
                                     Foreground="#8997A9"
                                     FontSize="8"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Classes="panel" Padding="13">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Updates" Classes="sectionTitle" />
                    <TextBlock Grid.Column="1" Text="View All  →"
                               Foreground="#0969DA" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <ItemsControl x:Name="DashboardUpdateItems">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:DashboardUpdateItem">
                        <Grid ColumnDefinitions="30,*,Auto"
                              ColumnSpacing="8"
                              Margin="0,4">
                          <Border Width="28" Height="28"
                                  CornerRadius="7"
                                  Background="#EAF3FF">
                            <TextBlock Text="{Binding IconText}"
                                       Foreground="#1769D2"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="#26354E"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}"
                                       Foreground="#8A97A9"
                                       FontSize="8"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Border Grid.Column="2"
                                  Background="{Binding StatusBackground}"
                                  CornerRadius="8"
                                  Padding="7,3"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusForeground}"
                                       FontSize="8"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="2" Classes="panel" Padding="13">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="My Device" Classes="sectionTitle" />
                    <TextBlock Grid.Column="1" Text="View Details  →"
                               Foreground="#0969DA" FontSize="9" VerticalAlignment="Center" />
                  </Grid>
                  <Grid ColumnDefinitions="74,*" ColumnSpacing="10">
                    <Border Width="70" Height="54" CornerRadius="8" Background="#EAF3FF">
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="▱" FontSize="24" Foreground="#1769D2"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Hi5" FontSize="8" Foreground="#58718B"
                                   HorizontalAlignment="Center" />
                      </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock x:Name="DeviceNameText"
                                 Text="This device"
                                 Foreground="#17233A"
                                 FontWeight="Bold"
                                 FontSize="10" />
                      <TextBlock x:Name="DeviceModelText"
                                 Text="Managed endpoint"
                                 Foreground="#748399"
                                 FontSize="8"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="112,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                        RowSpacing="5">
                    <TextBlock Grid.Row="0" Text="Operating System" Classes="muted" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeviceOsText"
                               Text="Windows" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="1" Text="Device Health" Classes="muted" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DeviceHealthText"
                               Text="Connected" Foreground="#16825F" FontSize="9" />
                    <TextBlock Grid.Row="2" Text="Encryption" Classes="muted" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DeviceEncryptionText"
                               Text="Not reported" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="3" Text="Last Sync" Classes="muted" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DeviceLastSyncText"
                               Text="Not reported" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="4" Text="Storage" Classes="muted" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DeviceStorageText"
                               Text="Not reported" Foreground="#34445C" FontSize="9" />
                    <TextBlock Grid.Row="5" Text="Assigned User" Classes="muted" />
                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="DeviceUserText"
                               Text="Signed-in user" Foreground="#34445C" FontSize="9"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="panel" Padding="13">
              <Grid ColumnDefinitions="220,*,*,*,*" ColumnSpacing="9">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="Help &amp; Support" Classes="sectionTitle" />
                  <TextBlock Text="Get help from the IT team or find useful resources."
                             Foreground="#7E8CA0"
                             FontSize="8"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="ghost" Content="Request Remote Help   ›" />
                <Button Grid.Column="2" Classes="ghost" Content="Open Ticket   ›" />
                <Button Grid.Column="3" Classes="ghost" Content="Knowledge Base   ›" />
                <Button Grid.Column="4" Classes="ghost" Content="Chat with IT   ›" />
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="LoadingOverlay"
                Background="#EAF4F7FB"
                IsVisible="True">
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Width="250"
                      Spacing="10">
            <ProgressBar IsIndeterminate="True" Height="5" />
            <TextBlock Text="Loading Hi5 Self Service..."
                       Foreground="#66778E"
                       FontSize="10"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
        <Border x:Name="StatusBanner"
                IsVisible="False"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Width="420"
                Margin="0,0,18,18"
                Padding="12,10"
                CornerRadius="10"
                Background="#EAF8F2"
                BorderBrush="#C5EBDD"
                BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock x:Name="StatusTitle"
                         Text="Done"
                         Foreground="#146B50"
                         FontSize="10"
                         FontWeight="Bold" />
              <TextBlock x:Name="StatusMessage"
                         Foreground="#5E6D7F"
                         FontSize="9"
                         TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="×"
                    Click="DismissStatus_Click"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#5E6D7F"
                    FontSize="15" />
          </Grid>
        </Border>

        <TextBlock x:Name="AgentStatusText"
                   IsVisible="False"
                   Text="Connected through Hi5Central Agent" />
      </Grid>
    </Grid>
  </Grid>
</Window>